DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-key-change-before-deploy
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=
PORTAL_ORGANISATION_CODE=
SUPER_ADMIN_ACCESS_CODE=

# Local PostgreSQL (leave POSTGRES_URL blank).
POSTGRES_URL=
PGDATABASE=tgm_studentportal
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=

# Production: set DJANGO_DEBUG=false and a random DJANGO_SECRET_KEY.
# Set POSTGRES_URL to the hosted PostgreSQL pooled URL with sslmode=require.
# Use exact backend/ frontend hosts and HTTPS CSRF origins; never commit secrets.
